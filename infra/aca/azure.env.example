# Global
AZ_LOCATION=spaincentral
AZ_RESOURCE_GROUP=rg-rag-domingo-prod
AZ_SUBSCRIPTION_ID=<tu-azure-subscription-id>
AZURE_TENANT_ID=<tu-azure-tenant-id>

# Container registry (GitHub Container Registry)
GHCR_USERNAME=<tu-github-username>
# Optional if Docker credential helper already stores the GHCR login
# GHCR_TOKEN=<github-pat-with-write-packages>

# Container apps (solo backend)
AZ_CONTAINERAPPS_ENV=cae-rag-domingo
AZ_BACKEND_APP=rag-backend
BACKEND_MIN_REPLICAS=1
BACKEND_MAX_REPLICAS=2

# Static Web App (frontend — plan Free, sin coste)
AZ_STATIC_WEB_APP=rag-frontend-swa

# Domain
ROOT_DOMAIN=domingoberbel.com
API_SUBDOMAIN=api.domingoberbel.com
WEB_SUBDOMAIN=domingoberbel.com

# Product constraints
CONTACT_EMAILS=<tu-email@example.com>
PROFESSIONAL_LINKEDIN=<linkedin-url>
ADMIN_READ_KEY=<clave-larga-admin>
MAX_REQUESTS_PER_MINUTE_PER_IP=20
# Real tokens billed by the model per day (not an estimate). See backend/app/config.py.
MAX_TOKENS_PER_DAY=2000000

# Captcha (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=<site-key>
TURNSTILE_SECRET_KEY=<secret-key>

# Generation (OpenAI API — there is no Azure OpenAI resource)
OPENAI_API_KEY=<tu-openai-api-key>
OPENAI_MODEL=gpt-5.6-luna

# Embeddings (Google Gemini). Changing the model requires a full reindex.
GOOGLE_API_KEY=<tu-google-api-key>
EMBEDDING_MODEL=gemini-embedding-2

# All credentials must be stored as Container Apps SECRETS, never as plain
# environment variables:
#   az containerapp secret set -n rag-backend -g rg-rag-domingo-prod \
#       --secrets openai-api-key=<value> google-api-key=<value> admin-read-key=<value>
#   az containerapp update -n rag-backend -g rg-rag-domingo-prod --set-env-vars \
#       OPENAI_API_KEY=secretref:openai-api-key \
#       GOOGLE_API_KEY=secretref:google-api-key \
#       ADMIN_READ_KEY=secretref:admin-read-key
#
# There is no AZURE_OPENAI_* or AZURE_SEARCH_* configuration: both resources were
# deleted from the subscription.

# FUTBOARD storage — Neon Postgres, AWS region (not Azure: Neon is
# deprecating its Azure regions). Use the -pooler host.
# Optional: without it the FUTBOARD endpoints answer 503 and the rest
# of the site is unaffected.
FUTBOARD_DATABASE_URL=
